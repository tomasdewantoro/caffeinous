<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<!-- Mac App Store build (built with --no-default-features, so no lid feature).
     IOKit power assertions and SMAppService work inside the sandbox; nothing else is needed. -->
<dict>
	<key>com.apple.security.app-sandbox</key>
	<true/>
</dict>
</plist>
